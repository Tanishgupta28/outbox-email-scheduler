# NODE_ENV defaults to development for Node; production containers override it.
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=mysql://outbox:outbox_local@127.0.0.1:3307/outbox
REDIS_URL=redis://127.0.0.1:6380
QUEUE_NAME=outbox-email
WORKER_CONCURRENCY=3
RATE_LIMIT_MAX=2
RATE_LIMIT_DURATION_MS=10000
MAX_ATTEMPTS=3
RETRY_DELAY_MS=2000
RECONCILE_INTERVAL_MS=3000
MAIL_TRANSPORT=ethereal
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Outbox Demo <demo@outbox.example>
# Public sandbox identities, not personal credentials. Change before non-demo use.
DEMO_PASSWORD=OutboxDemo2026!
